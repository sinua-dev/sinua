  "before1_10": {
    "$comment": "FX Spec 1.8 and 1.9 files resolved their voice states with particles; from 1.10 (and in plain views) the shared profile has none. These are the old particle values, applied only for a file that declares fxSpec 1.8 or 1.9, so its meaning doesn't change (the identity locks hold it). Order: generic state, then these, then the pattern's own entry, then its entry here.",
    "states": {
      "listening": {
        "overrides": {
          "particleStrength": 1,
          "particleStyle": 1,
          "particleCount": 36,
          "particleSize": 1.4,
          "particleSpread": 0.4,
          "particleLife": 1.8,
          "particleAudio": 1
        }
      },
      "thinking": {
        "overrides": {
          "particleStrength": 0.8,
          "particleStyle": 2,
          "particleCount": 16
        }
      },
      "speaking": {
        "overrides": {
          "particleStrength": 1,
          "particleStyle": 0,
          "particleCount": 32,
          "particleLife": 1.4,
          "particleAudio": 1
        }
      }
    },
    "patterns": {
      "generating": {
        "states": {
          "listening": {
            "overrides": {
              "particleCount": 16,
              "particleSize": 1.0,
              "particleSpread": 0.25
            }
          }
        }
      }
    }
  },
  "exceptions": {
    "$comment": "Patterns the generic state language doesn't fit. `fixed` ones have a tuned entry under `patterns`; `open` ones are still weak and say why, measured with a ladder (mean ink / motion / lowest single-frame ink, engine units, size 64).",
    "glowing": {
      "status": "fixed",
      "was": "aurora cycles its own hue, so the states drifted pink/blue",
      "now": "the showcase pins the colour; states differ by texture and energy (29/10 - 86/75 - 47/31 - 126/139)"
    },
    "muted": {
      "status": "fixed",
      "was": "hush dims itself, so every state was near-invisible",
      "now": "idle keeps a resting dim, active states come up (12 - 65 - 29 - 80)"
    },
    "calibrating": {
      "status": "fixed",
      "was": "chladni's figures too fine to read at 64 px",
      "now": "bigger nodes and a shorter hold per state (20 - 77 - 43 - 94)"
    },
    "confirming": {
      "status": "fixed",
      "was": "sonar was empty between pings at idle (lowest frame ink 0.48)",
      "now": "a resting core and closer echoes; lowest frame ink 3.79",
      "note": "Without voice states (the bare pattern) sonar still empties between pings -- that is the pattern's own cycle, and the profile only applies when a state is set."
    },
    "speaking": {
      "status": "partial",
      "was": "spectrum's bars follow the mic too, so listening read louder than speaking",
      "now": "listening sheds its particles and sits back (10 vs speaking 23), but it still measures close to thinking (12) -- the bars are the same shape in both"
    },
    "generating": {
      "status": "open",
      "issue": "shimmer is a thin track with a travelling highlight, so there is little to modulate: speaking (6) still doesn't beat listening (10) or thinking (10). It needs its own speaking treatment in the mode, not more overrides."
    },
    "concluding": {
      "status": "open",
      "issue": "crystallize dissolves completely inside its cycle, so a single frame can still be near-blank (lowest frame ink 0.42 at idle, 0.96 while speaking). A still, denser lattice raised the floor but only the mode can remove the gap.",
      "note": "Same caveat as `confirming`: the bare pattern empties on its own cycle; the profile's denser lattice only applies when a state is set."
    },
    "shaping": {
      "status": "open",
      "issue": "morph changes between circle, square and triangle by design, which cuts against 'one shape stays on screen'. Fine as a standalone pattern, wrong as a voice base."
    },
    "signal-family": {
      "status": "by-design",
      "patterns": [
        "signaling",
        "waveform",
        "scrolling",
        "metering"
      ],
      "note": "they already carry voice states through `voiceStateCode` and the audio bands, so the profile only lends them ink, glow and tempo; their own behaviour is left alone."
    },
    "value-driven-rings": {
      "status": "fixed",
      "patterns": [
        "completing",
        "tracking",
        "stepping",
        "measuring"
      ],
      "was": "thinking equalled idle: nothing moves, so there was no tempo to raise",
      "now": "the profile's pulse carries it (e.g. completing idle motion 1.8 vs thinking 13.9); the value itself is never touched"
    }
  }
}
