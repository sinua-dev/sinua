{
  "$schema": "https://sinua.dev/schema/fx-spec-1.json",
  "fxSpec": "1.13",
  "name": "Hum with light-point eyes",
  "description": "An eye style (FX Spec 1.13, design note 24): `\"eyeStyle\": \"dot\"` turns Hum's eyes into two soft glowing points: a minimal look. A blink squashes them; expressions tilt and scale them a little.",
  "object": "character",
  "pattern": "hum",
  "size": 64,
  "params": {
    "eyeStyle": "dot",
    "seed": 5
  },
  "bindings": {
    "muted": {
      "input": "micMuted"
    }
  },
  "states": {
    "initializing": {},
    "idle": {},
    "listening": {
      "bindings": {
        "audioLevel": {
          "input": "micLevel"
        }
      }
    },
    "thinking": {},
    "speaking": {
      "bindings": {
        "audioLevel": {
          "input": "agentVolume",
          "inputRange": [0, 0.8]
        }
      }
    }
  },
  "accessibility": {
    "name": "Hum"
  }
}
