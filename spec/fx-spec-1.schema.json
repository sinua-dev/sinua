{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sinua.dev/schema/fx-spec-1.json",
  "title": "FX Spec v1 (1.8 and later)",
  "description": "One Sinua object in one pattern. Editor aid only: the runtime validator (core_engine::fx_spec, exported as resolveFxSpec / resolve_fx_spec) is the authority -- it also checks that `object` matches the pattern's family, that every `params` key is one the pattern's mode reads, and applies the glTF minor-version rule (unknown keys are errors in a file this runtime fully knows, warnings in a newer 1.x file). The oldest version the runtime reads is 1.8: 1.0-1.7 were never published, so their acceptance (and the old names 1.7 replaced -- `state`, engine-key binding targets) was dropped before the first release. What each minor added, for reference: 1.1 `states` (a lifecycle map merged over the top-level design, RFC 7396) and `bindings` (app inputs -> curated Reactive targets); 1.2 `performance`; 1.3 glow `mode`/`blend` and shedding `blur`; 1.4 `materials.liquid`; 1.5 `materials.particles`; 1.6 `materials.holographic` and particles `sync`/`audio`; 1.7 the parameter catalog's names (`pattern`, dotted binding targets, array params); 1.8 `ink` and the built-in voice-state profile. 0.1.0-beta.9 (1.14) removed `materials.liquid`, `materials.particles` and `materials.holographic`: a file that uses one is rejected. See docs/fx-spec.md.",
  "type": "object",
  "required": [
    "fxSpec",
    "object",
    "pattern"
  ],
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "type": "string"
    },
    "fxSpec": {
      "type": "string",
      "pattern": "^1\\.([8-9]|[1-9][0-9]+)$",
      "description": "\"major.minor\", 1.8 or later (the runtime's floor; 1.0-1.7 are rejected). The runtime reads up to 1.15 strictly; a newer 1.x file resolves, with its unknown keys reported as warnings."
    },
    "name": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "object": {
      "enum": [
        "orb",
        "signal",
        "ring",
        "beacon",
        "core"
      ]
    },
    "pattern": {
      "type": "string",
      "description": "The visual pattern, e.g. working, veil, tracking, scanning, generating. Must belong to `object`'s family."
    },
    "size": {
      "enum": [
        20,
        32,
        64
      ],
      "default": 64
    },
    "speed": {
      "type": "number",
      "minimum": 0,
      "maximum": 100,
      "default": 1,
      "description": "Multiplier on the preset's tuned speed; frameFromFxSpec applies elapsed * presetSpeed * speed."
    },
    "ink": {
      "type": "number",
      "minimum": 0,
      "maximum": 1,
      "default": 1,
      "description": "FX Spec 1.8: the whole visual's opacity, 0 to 1. 1 draws it as the pattern defines it; lower fades everything, halos included. A state patches it (a voice assistant's idle typically sits below 1)."
    },
    "color": {
      "description": "A color (shorthand for { value, mix: 1 }) or the full section.",
      "oneOf": [
        {
          "$ref": "#/$defs/color"
        },
        {
          "$ref": "#/$defs/colorSection"
        }
      ]
    },
    "gradient": {
      "$ref": "#/$defs/gradient"
    },
    "materials": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "glow": {
          "$ref": "#/$defs/glow"
        },
        "noise": {
          "$ref": "#/$defs/noise"
        },
        "pulse": {
          "$ref": "#/$defs/pulse"
        }
      }
    },
    "params": {
      "type": "object",
      "description": "Per-state engine opts (docs/parameters.md). Runtime inputs (pointer*, audio*, interrupt*, muted*, voiceStateCode) and section-owned keys (color*, gradient*, glow*, noise*, pulse*) are rejected here. FX Spec 1.7: `envelope` may be an array.",
      "additionalProperties": {
        "anyOf": [
          {
            "type": "number"
          },
          {
            "type": "array",
            "items": {
              "type": "number"
            },
            "minItems": 1,
            "maxItems": 64,
            "description": "FX Spec 1.7: `envelope` (dune, 1-64 values) as a list. One key per item (`envelope12`) is also accepted."
          }
        ]
      }
    },
    "bindings": {
      "$ref": "#/$defs/bindings"
    },
    "states": {
      "type": "object",
      "description": "Lifecycle key -> design entry, merged over the top-level design (RFC 7396: objects merge, null deletes, arrays replace). Keys are free-form; LiveKit's AgentState names (initializing, idle, listening, thinking, speaking) are the convention. A state not listed renders the top-level design.",
      "additionalProperties": {
        "$ref": "#/$defs/stateEntry"
      }
    },
    "performance": {
      "$ref": "#/$defs/performance"
    },
    "transitions": {
      "$ref": "#/$defs/transitions"
    },
    "rules": {
      "$ref": "#/$defs/rules"
    },
    "accessibility": {
      "$ref": "#/$defs/accessibility"
    }
  },
  "$defs": {
    "hex": {
      "type": "string",
      "pattern": "^#?([0-9a-fA-F]{3}|[0-9a-fA-F]{6})$"
    },
    "dtcgColor": {
      "description": "W3C Design Tokens Color Module 2025.10 color value. srgb and hsl convert exactly; other color spaces need `hex` (used as a fallback, with a warning).",
      "type": "object",
      "required": [
        "colorSpace",
        "components"
      ],
      "additionalProperties": false,
      "properties": {
        "colorSpace": {
          "enum": [
            "srgb",
            "srgb-linear",
            "hsl",
            "hwb",
            "lab",
            "lch",
            "oklab",
            "oklch",
            "display-p3",
            "a98-rgb",
            "prophoto-rgb",
            "rec2020",
            "xyz-d65",
            "xyz-d50"
          ]
        },
        "components": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "items": {
            "oneOf": [
              {
                "type": "number"
              },
              {
                "const": "none"
              }
            ]
          }
        },
        "alpha": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "hex": {
          "type": "string",
          "pattern": "^#[0-9a-fA-F]{6}$"
        }
      }
    },
    "color": {
      "oneOf": [
        {
          "$ref": "#/$defs/hex"
        },
        {
          "$ref": "#/$defs/dtcgColor"
        }
      ]
    },
    "colorSection": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "value": {
          "$ref": "#/$defs/color"
        },
        "mix": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "default": 1
        },
        "lightness": {
          "type": "number",
          "minimum": -1,
          "maximum": 1,
          "default": 0
        },
        "mode": {
          "enum": [
            "ink",
            "fixed"
          ],
          "default": "ink"
        }
      }
    },
    "gradient": {
      "type": "object",
      "required": [
        "stops"
      ],
      "additionalProperties": false,
      "properties": {
        "stops": {
          "type": "array",
          "minItems": 2,
          "maxItems": 3,
          "items": {
            "$ref": "#/$defs/color"
          }
        },
        "angle": {
          "type": "number",
          "minimum": -360,
          "maximum": 720,
          "default": 90
        },
        "strength": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "default": 1
        },
        "saturation": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "default": 0.8
        },
        "mid": {
          "type": "number",
          "minimum": 0.05,
          "maximum": 0.95,
          "default": 0.5
        },
        "path": {
          "enum": [
            "short",
            "long"
          ],
          "default": "short"
        }
      }
    },
    "glow": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "strength": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "radius": {
          "type": "number",
          "minimum": 1,
          "maximum": 8,
          "default": 2.5
        },
        "layers": {
          "type": "number",
          "minimum": 1,
          "maximum": 8,
          "default": 4
        },
        "tint": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "default": 0
        },
        "hue": {
          "type": "number",
          "minimum": 0,
          "maximum": 360,
          "default": 200
        },
        "mode": {
          "enum": [
            "stacked",
            "blur"
          ],
          "default": "stacked",
          "description": "stacked = concentric copies (every renderer); blur = one Gaussian-blurred halo per element (paint-contract blur). Low power with disable: [\"blur\"] falls back to stacked."
        },
        "blend": {
          "enum": [
            "normal",
            "additive"
          ],
          "default": "normal",
          "description": "How blur-mode halos composite: additive = Canvas `lighter` / SwiftUI plusLighter / Compose BlendMode.Plus."
        }
      }
    },
    "noise": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "strength": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "amplitude": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "default": 0.04
        },
        "scale": {
          "type": "number",
          "minimum": 0,
          "maximum": 64,
          "default": 2
        },
        "speed": {
          "type": "number",
          "minimum": 0,
          "maximum": 16,
          "default": 0.4
        },
        "seed": {
          "type": "number",
          "default": 0
        }
      }
    },
    "pulse": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "strength": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "period": {
          "type": "number",
          "minimum": 0.05,
          "maximum": 60
        },
        "opacity": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "scale": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "phase": {
          "type": "number"
        }
      }
    },
    "curve": {
      "enum": [
        "linear",
        "ease",
        "easeIn",
        "easeOut",
        "easeInOut"
      ]
    },
    "binding": {
      "type": "object",
      "required": [
        "input"
      ],
      "additionalProperties": false,
      "description": "Maps the app's own input value to one Reactive target (docs/parameters.md): multi-stop, either direction, one CSS keyword curve per segment, always clamped to the target's range.",
      "properties": {
        "input": {
          "type": "string",
          "minLength": 1,
          "description": "The app's input name (e.g. micLevel, steps, heartRate); the engine never interprets it. Missing at runtime = binding inactive."
        },
        "inputRange": {
          "type": "array",
          "minItems": 2,
          "items": {
            "type": "number"
          },
          "default": [
            0,
            1
          ]
        },
        "outputRange": {
          "type": "array",
          "minItems": 2,
          "items": {
            "type": "number"
          },
          "description": "Default: the target's range."
        },
        "curve": {
          "oneOf": [
            {
              "$ref": "#/$defs/curve"
            },
            {
              "type": "array",
              "items": {
                "$ref": "#/$defs/curve"
              }
            }
          ],
          "default": "linear"
        }
      }
    },
    "bindings": {
      "type": "object",
      "description": "Keyed by target, so each target is bound once and a state can override or delete (null) one. FX Spec 1.7 names the targets like the parameter catalog's paths: `glow.strength`, `noise.strength`, `gradient.strength`, `pulse.strength`, `color.mix`; the engine-key names (`glowStrength`) are errors that name the path to use.",
      "propertyNames": {
        "enum": [
          "progress",
          "level",
          "quality",
          "accuracy",
          "audioLevel",
          "glowStrength",
          "noiseStrength",
          "gradientStrength",
          "pulseStrength",
          "colorMix",
          "muted",
          "glow.strength",
          "noise.strength",
          "gradient.strength",
          "pulse.strength",
          "color.mix"
        ]
      },
      "additionalProperties": {
        "anyOf": [
          {
            "$ref": "#/$defs/binding"
          },
          {
            "type": "null"
          }
        ]
      }
    },
    "stateEntry": {
      "type": "object",
      "additionalProperties": false,
      "description": "A design override for one lifecycle state. `object` and `size` are file-wide. null deletes an inherited value.",
      "properties": {
        "pattern": {
          "type": "string",
          "description": "The pattern for this lifecycle key; defaults to the top-level pattern."
        },
        "speed": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        },
        "ink": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "description": "FX Spec 1.8: this state's opacity; inherits the top-level `ink` when absent."
        },
        "color": {
          "anyOf": [
            {
              "$ref": "#/$defs/color"
            },
            {
              "$ref": "#/$defs/colorSection"
            },
            {
              "type": "null"
            }
          ]
        },
        "gradient": {
          "anyOf": [
            {
              "$ref": "#/$defs/gradientPatch"
            },
            {
              "type": "null"
            }
          ]
        },
        "materials": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "glow": {
                  "anyOf": [
                    {
                      "$ref": "#/$defs/glow"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "noise": {
                  "anyOf": [
                    {
                      "$ref": "#/$defs/noise"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "pulse": {
                  "anyOf": [
                    {
                      "$ref": "#/$defs/pulse"
                    },
                    {
                      "type": "null"
                    }
                  ]
                }
              }
            }
          ]
        },
        "params": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "object",
              "additionalProperties": {
                "type": [
                  "number",
                  "null"
                ]
              }
            }
          ]
        },
        "bindings": {
          "anyOf": [
            {
              "$ref": "#/$defs/bindings"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "gradientPatch": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "stops": {
          "type": "array",
          "minItems": 2,
          "maxItems": 3,
          "items": {
            "$ref": "#/$defs/color"
          }
        },
        "angle": {
          "type": "number",
          "minimum": -360,
          "maximum": 720,
          "default": 90
        },
        "strength": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "default": 1
        },
        "saturation": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "default": 0.8
        },
        "mid": {
          "type": "number",
          "minimum": 0.05,
          "maximum": 0.95,
          "default": 0.5
        },
        "path": {
          "enum": [
            "short",
            "long"
          ],
          "default": "short"
        }
      },
      "description": "A state's gradient override: merged over the inherited gradient, so `stops` may be omitted."
    },
    "performance": {
      "type": "object",
      "additionalProperties": false,
      "description": "File-wide. The host paces frames and detects power state (iOS Low Power Mode, Android Battery Saver, or an app policy) and passes lowPower; the spec declares the cap and what to shed.",
      "properties": {
        "maxFps": {
          "type": "number",
          "minimum": 1,
          "maximum": 120,
          "description": "Frame-rate cap the host should honour. Absent = the host's default."
        },
        "lowPower": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "maxFps": {
              "type": "number",
              "minimum": 1,
              "maximum": 120,
              "description": "Cap under low power; absent = maxFps."
            },
            "disable": {
              "type": "array",
              "uniqueItems": true,
              "items": {
                "enum": [
                  "glow",
                  "noise",
                  "pulse",
                  "gradient",
                  "blur"
                ]
              },
              "description": "Materials whose strength goes to 0 under low power (after bindings)."
            }
          }
        }
      }
    },
    "transition": {
      "type": "object",
      "description": "One state change (1.9): its length in seconds and a CSS keyword curve.",
      "additionalProperties": false,
      "properties": {
        "duration": {
          "type": "number",
          "minimum": 0,
          "maximum": 10
        },
        "curve": {
          "$ref": "#/$defs/curve"
        }
      }
    },
    "transitions": {
      "type": "object",
      "description": "1.9: how state changes animate. Keys: `default`, `from->to`, `from->*`, `*->to` (state keys); the most specific wins. Without it: 0.6 s easeInOut.",
      "propertyNames": {
        "pattern": "^(default|[^>]+->[^>]+)$"
      },
      "additionalProperties": {
        "$ref": "#/$defs/transition"
      }
    },
    "rules": {
      "type": "array",
      "description": "1.9: derived states. Tried in order; the first rule whose condition holds picks the `states` entry that renders. None holds: the caller's own state. A rule whose input isn't passed doesn't hold.",
      "maxItems": 32,
      "items": {
        "$ref": "#/$defs/rule"
      }
    },
    "rule": {
      "type": "object",
      "required": [
        "when",
        "state"
      ],
      "additionalProperties": false,
      "properties": {
        "when": {
          "$ref": "#/$defs/ruleWhen"
        },
        "state": {
          "type": "string",
          "minLength": 1,
          "description": "The `states` key this rule renders."
        },
        "hysteresis": {
          "type": "number",
          "minimum": 0,
          "description": "While already in this state, the condition is relaxed by this much, so the state doesn't flicker around its threshold."
        }
      }
    },
    "ruleWhen": {
      "type": "object",
      "required": [
        "input"
      ],
      "additionalProperties": false,
      "minProperties": 2,
      "maxProperties": 2,
      "properties": {
        "input": {
          "type": "string",
          "minLength": 1,
          "description": "The app input to compare (a key of the view's `inputs`)."
        },
        "gt": {
          "type": "number"
        },
        "gte": {
          "type": "number"
        },
        "lt": {
          "type": "number"
        },
        "lte": {
          "type": "number"
        },
        "between": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": {
            "type": "number"
          },
          "description": "[low, high], both inclusive."
        }
      }
    },
    "accessibility": {
      "type": "object",
      "description": "FX Spec 1.9 (docs/fx-spec.md, *v1.9: accessibility*): the view's accessible name, per-state words (they replace the name while that state shows; the app's `labels` win), and whether state changes are spoken (default true; polite and rate-limited by the engine).",
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string",
          "description": "The view's accessible name (over the file's `name`; the app's `label` wins)."
        },
        "states": {
          "type": "object",
          "description": "Words per state key (any key of `states`, or a voice state). A voice state without words reads \"<name>, listening\".",
          "additionalProperties": {
            "type": "string"
          }
        },
        "announce": {
          "type": "boolean",
          "description": "Speak state changes (default true). The app's `announce` option wins."
        }
      }
    }
  }
}
