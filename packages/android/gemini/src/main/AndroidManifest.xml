<!-- The Gemini Live socket needs the network; merged into the app's manifest.
     MODIFY_AUDIO_SETTINGS (a normal permission, no prompt) lets the source set up the
     call's audio (VoiceAudioSession). RECORD_AUDIO stays the app's to declare and request (as with LocalMicVoiceSource). -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />
</manifest>
