{
 "compilerOptions": {
  "target": "ES2022",
  "module": "ESNext",
  "moduleResolution": "Bundler",
  "jsx": "react-jsx",
  "strict": true,
  "noEmit": true,
  "skipLibCheck": true,
  "resolveJsonModule": true,
  "preserveSymlinks": true,
  "lib": [
   "ES2022",
   "DOM"
  ],
  "paths": {
   "react": [
    "../node_modules/@types/react"
   ],
   "react/*": [
    "../node_modules/@types/react/*"
   ]
  }
 },
 "files": [
  "ok.tsx"
 ]
}