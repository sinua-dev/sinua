{
 "compilerOptions": {
  "target": "ES2022",
  "module": "ESNext",
  "moduleResolution": "Bundler",
  "strict": true,
  "jsx": "preserve",
  "jsxImportSource": "solid-js",
  "resolveJsonModule": true,
  "skipLibCheck": true,
  "noEmit": true,
  "types": [
   "vite/client"
  ],
  "lib": [
   "ES2022",
   "DOM"
  ],
  "preserveSymlinks": true
 },
 "include": [
  "src"
 ]
}