/target
**/*.rs.bk
.DS_Store
node_modules/
dist/

# Regenerated by packages/ios/build.sh -- see that script, not these paths.
/bindings/
packages/ios/core_engineFFI.xcframework/
packages/ios/Sources/CoreEngine/core_engine.swift
/.build/
packages/ios/.build/
packages/ios/.swiftpm/
# SwiftPM / SourceKit output of the LiveKit glue package (Package.resolved stays tracked: it pins the SDK).
packages/ios-livekit/.build/
packages/ios-livekit/.swiftpm/
packages/ios-openai/.build/
packages/ios-openai/.swiftpm/

# The device bench (docs/bench.md): regenerated by `xcodegen generate` in
# apps/fx-bench-ios, and Gradle output of the :fx-bench-android subproject.
apps/fx-bench-ios/FxBench.xcodeproj/
apps/fx-bench-android/build/

# Regenerated by packages/android/build.sh -- see that script, not these paths.
packages/android/src/main/kotlin/uniffi/
packages/android/src/main/jniLibs/
packages/android/build/
packages/android/.gradle/
packages/android/.kotlin/
packages/android/local.properties

# Regenerated by packages/react-native/build.sh -- see that script, not
# these paths (copies from packages/ios and packages/android, no rebuild).
packages/react-native/android/src/main/kotlin/uniffi/
packages/react-native/android/src/main/jniLibs/
packages/react-native/android/build/
packages/react-native/ios/CoreEngine/
packages/react-native/core_engineFFI.xcframework/
packages/react-native/local.properties
# example/ has its own .gitignore (from the RN template) covering
# node_modules, Pods, build/, .gradle, etc. -- its actual source is tracked.
.claude/settings.local.json


# wasm-pack output + the inlined glue, regenerated by `npm run build:wasm` in
# packages/core (its own pkg/.gitignore is removed so npm pack ships pkg/).
packages/core/pkg/

# The docs' Swift / Kotlin samples compile as packages (scripts/docs/check-code-snippets.sh --native).
apps/site/snippets/.swiftpm/
apps/site/snippets/.build/
apps/site/snippets/build/
apps/site/snippets/android/build/

# Pinned lint binaries fetched by scripts/lint-*.sh
.cache/

# scripts/materials-check.sh: the Web's frames, the collected native renders,
# the .xcresult they came out of, and the contact sheet.
/out/

# Gradle output of the packages/android submodules (view + vendor adapters),
# Gradle/Kotlin caches anywhere, and test-coverage reports.
packages/android/*/build/
.gradle/
.kotlin/
coverage/

# A session scratchpad path once landed in the repo as a relative path
# (private/tmp/claude-*/.../frames.json, committed in 1c50607). Never tracked.
/private/

# The Angular CLI build cache (apps/examples/web-component/angular).
.angular/
