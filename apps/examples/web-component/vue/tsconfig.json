{
 "compilerOptions": {
  "target": "ES2022",
  "module": "ESNext",
  "moduleResolution": "Bundler",
  "strict": true,
  "jsx": "preserve",
  "resolveJsonModule": true,
  "skipLibCheck": true,
  "noEmit": true,
  "lib": [
   "ES2022",
   "DOM"
  ],
  "preserveSymlinks": true
 },
 "include": [
  "src/**/*.ts",
  "src/**/*.vue"
 ]
}