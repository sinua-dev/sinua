{
  "$schema": "https://sinua.dev/schema/fx-spec-1.json",
  "fxSpec": "1.13",
  "name": "Beep with pixel eyes",
  "description": "An eye style (FX Spec 1.13): `\"eyeStyle\": \"pixel\"` lights Beep's eyes as a grid of glowing cells (on BUZZY's face screen the mouth goes pixel too). Blinks become a row of cells; expressions reshape the grid.",
  "object": "character",
  "pattern": "beep",
  "size": 64,
  "params": {
    "eyeStyle": "pixel",
    "seed": 4
  },
  "bindings": {
    "muted": {
      "input": "micMuted"
    }
  },
  "states": {
    "initializing": {},
    "idle": {},
    "listening": {
      "bindings": {
        "audioLevel": {
          "input": "micLevel"
        }
      }
    },
    "thinking": {},
    "speaking": {
      "bindings": {
        "audioLevel": {
          "input": "agentVolume",
          "inputRange": [0, 0.8]
        }
      }
    }
  },
  "accessibility": {
    "name": "Beep"
  }
}
