{
  "$schema": "../fx-spec-1.schema.json",
  "fxSpec": "1.8",
  "name": "Fitness rings",
  "description": "Daily goals as activity rings: steps, water and active minutes drive the three rings (goal = one lap; steps go on to extra laps, up to 3 at 30k), heart rate drives the glow. 'goalReached' swaps to a full completion ring and drops the bindings it no longer needs (null deletes, RFC 7396).",
  "object": "ring",
  "pattern": "tracking",
  "size": 64,
  "color": {
    "value": "#30A46C",
    "mix": 0.6
  },
  "materials": {
    "glow": {
      "radius": 3
    }
  },
  "params": {
    "ringCount": 3
  },
  "bindings": {
    "progress[0]": {
      "input": "steps",
      "inputRange": [
        0,
        10000,
        30000
      ],
      "outputRange": [
        0,
        1,
        3
      ],
      "curve": [
        "easeOut",
        "linear"
      ]
    },
    "progress[1]": {
      "input": "waterMl",
      "inputRange": [
        0,
        2500
      ]
    },
    "progress[2]": {
      "input": "activeMinutes",
      "inputRange": [
        0,
        30
      ]
    },
    "glow.strength": {
      "input": "heartRate",
      "inputRange": [
        60,
        100,
        160
      ],
      "outputRange": [
        0,
        0.2,
        0.8
      ],
      "curve": [
        "linear",
        "easeIn"
      ]
    }
  },
  "states": {
    "goalReached": {
      "pattern": "completing",
      "params": {
        "progress": 1
      },
      "materials": {
        "glow": {
          "strength": 0.7
        }
      },
      "bindings": {
        "progress[0]": null,
        "progress[1]": null,
        "progress[2]": null,
        "glow.strength": null
      }
    }
  }
}
